# Robfile for cuento: count the books you read, a web app on spark.
#
# The app is TypeScript in src/, compiled by tsc into build/site/ beside
# public/ (the page, its style and icon) and spark (src/spark/, vendored
# JavaScript with its own types). The tests are TypeScript too, run by
# Node as they are: in Node, and in headless Chromium (playwright-core;
# CHROMIUM names the browser). Prettier formats; Cloudflare serves
# build/site/ as static files. npm install once for the tools.

bin     = node_modules/.bin
spark   = /home/luis/r/spark
sparkv  = v0.1.1
port    = 8080

# The site, in build/site/: the landing page at its root, the app in
# app/; tools/precache.ts last, which writes the app's
# service worker with the list of files to keep offline.
task build:
    rm -rf build/site
    {bin}/tsc -p .
    cp -R public/. build/site/app/
    cp landing/index.html landing/landing.css build/site/
    cp -R landing/img build/site/
    cp tools/retired/sw.js build/site/sw.js
    mkdir -p build/site/app/spark
    cp src/spark/*.js src/spark/LICENSE build/site/app/spark/
    node tools/precache.ts

# The tests' types and the Worker's (its types written from wrangler.jsonc),
# the pure modules and sync, then the page in a browser.
task check: build
    {bin}/tsc -p test
    npx wrangler types worker/worker-configuration.d.ts >/dev/null
    {bin}/tsc -p worker
    node --test test/unit.test.ts test/sync.test.ts test/accounts.test.ts test/reminders.test.ts test/review.test.ts test/buy.test.ts test/browser.test.ts test/review-browser.test.ts test/scan.test.ts test/reminders-browser.test.ts test/shopping-browser.test.ts test/library-browser.test.ts

# The sources as Prettier lays them out (spark is spark's own).
task fmt:
    {bin}/prettier --check src/*.ts test tools public worker

# The site on http://localhost:{port}/ (the camera needs HTTPS: deploy).
task serve: build
    node test/serve.ts {port}

# spark, as tagged {sparkv} in {spark}, copied into src/spark/.
task spark:
    for f in core.js dom.js index.js index.d.ts; do git -C {spark} show {sparkv}:src/$f > src/spark/$f; done
    cp {spark}/LICENSE src/spark/LICENSE
    echo "spark {sparkv} (https://github.com/ldiaz94/spark), copied by robbie spark; ISC, see LICENSE." > src/spark/VERSION

# The README's pictures, from fixed books.
task shots: build
    node test/shots.ts

# Lines in cuento's own sources.
task loc:
    wc -l src/*.ts public/*.html public/*.css | sort -n

# Web Push's VAPID key pair, made once: the private half straight into
# the Worker's secret; the public half printed, for wrangler.jsonc.
task vapid:
    node tools/vapid.ts | npx wrangler secret put VAPID_PRIVATE_KEY

# To Cloudflare, once checked.
task deploy: check fmt
    npx wrangler deploy

# The PNG icons in public/, drawn from icon.svg (rsvg-convert).
task icons:
    /home/luis/r/concha/build/concha tools/icons.cn

# The fonts, self-hosted from Fontsource (OFL): Fraunces with all its
# axes for titles, Instrument Sans for the rest; Latin and Latin Extended.
task fonts:
    mkdir -p public/fonts
    cp node_modules/@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2 node_modules/@fontsource-variable/fraunces/files/fraunces-latin-ext-full-normal.woff2 public/fonts/
    cp node_modules/@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2 node_modules/@fontsource-variable/instrument-sans/files/instrument-sans-latin-ext-wght-normal.woff2 public/fonts/
    cp node_modules/@fontsource-variable/fraunces/LICENSE public/fonts/OFL-Fraunces.txt
    cp node_modules/@fontsource-variable/instrument-sans/LICENSE public/fonts/OFL-InstrumentSans.txt

# zxing-wasm's reader build (barcodes on browsers without BarcodeDetector),
# self-hosted: its JavaScript, WebAssembly and licence.
task zxing:
    mkdir -p public/vendor/zxing/reader
    cp node_modules/zxing-wasm/dist/es/share.js public/vendor/zxing/
    cp node_modules/zxing-wasm/dist/es/reader/index.js public/vendor/zxing/reader/
    cp node_modules/zxing-wasm/dist/reader/zxing_reader.wasm public/vendor/zxing/reader/
    cp node_modules/zxing-wasm/LICENSE public/vendor/zxing/

# qrcode-generator (MIT, Kazuhiko Arase; the licence is in its header),
# self-hosted for the QR code of the sync link in Settings.
task qrcode:
    mkdir -p public/vendor/qrcode
    cp node_modules/qrcode-generator/dist/qrcode.mjs public/vendor/qrcode/
