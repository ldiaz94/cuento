{
  // The tests: checked, never compiled (Node runs them as they are).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": "..",
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "../src/**/*.ts",
    "../tools/*.ts",
    "../worker/store.ts",
    "../worker/accounts.ts",
    "../worker/session.ts",
    "../worker/push.ts",
    "../worker/reminders.ts",
    "../worker/prices.ts"
  ]
}
